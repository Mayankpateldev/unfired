  {
    "id": "multi-item",
    "request": {
      "items": [
        {
          "sku": "A",
          "quantity": 2,
          "unit_cents": 1250
        },
        {
          "sku": "B",
          "quantity": 1,
          "unit_cents": 500
        }
      ],
      "discount_bps": 1000,
      "tax_bps": 500
    },
    "expected_status": 200,
    "expected_body": {
      "subtotal_cents": 3000,
      "discount_cents": 300,
      "taxable_cents": 2700,
      "tax_cents": 135,
      "total_cents": 2835,
      "units": 3
    }
  },
  {
    "id": "discount-half-cent",
